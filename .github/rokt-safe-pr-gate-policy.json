{
  "gateCheckName": "Rokt Safe PR Gate",
  "maxChangedLines": 500,
  "maxFiles": 10,
  "requiredWorkflows": [
    {
      "event": "pull_request",
      "path": ".github/workflows/pull-request.yml"
    }
  ],
  "roktOrganization": "ROKT",
  "safePaths": [
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "Kits/README.md",
    "IntegrationTests/README.md"
  ]
}
